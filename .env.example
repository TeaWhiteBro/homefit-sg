# Model provider for the chat assistant. Server-only: never expose these to the browser,
# never use a NEXT_PUBLIC_ prefix, and never commit a real key.
#
# Quick setup: run `npm run setup` (asks for your key and writes .env.local),
# then `npm run check-ai` to confirm the key works.
# Or copy this file to .env.local and fill in your own values.
#
# Any OpenAI-compatible Chat Completions endpoint should work. The defaults below are the
# provider the app was first developed with.
LLM_API_KEY=
LLM_BASE_URL=https://zenmux.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Optional. Models that always "think" (e.g. MiniMax-M3.1-Flash) spend output tokens on thinking,
# so raise the budget and lower the effort, otherwise replies get cut off. For example:
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M3.1-Flash
# LLM_MAX_TOKENS=4000
# LLM_EXTRA_BODY={"reasoning_effort":"low"}

# ZENMUX_API_KEY / ZENMUX_BASE_URL / ZENMUX_MODEL are read as a fallback when the LLM_*
# variables are not set.
